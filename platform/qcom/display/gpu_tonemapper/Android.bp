cc_library_shared {
    name: "libgpu_tonemapper",
    vendor: true,
    defaults: ["display_defaults"],

    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],
    shared_libs: [
        "libEGL",
        "libGLESv2",
        "libGLESv3",
        "libui",
        "libutils",
        "liblog",
    ],

    cflags: [
        "-Wno-missing-field-initializers",
        "-Wall",
        "-Wno-sign-conversion",
        "-Wno-unused-parameter",
        "-Wno-macro-redefined",
        "-Wno-unused-variable",
        "-Wno-unused-but-set-variable",
        "-Wno-format",
        "-Wno-sign-compare",
        "-Wno-unused-label",
        "-Wno-gnu-designator",
        "-Wno-typedef-redefinition",
        "-Wno-shorten-64-to-32",
        "-Wno-tautological-compare",
        "-Wno-unused-function",
        "-Wno-unused-local-typedef",
        "-Wno-tautological-pointer-compare",
        "-Wno-implicit-float-conversion",
        "-Wno-conversion",
        "-DLOG_TAG=\"GPU_TONEMAPPER\"",
        "-Wno-unused-value",
    ],

    srcs: [
        "TonemapFactory.cpp",
        "glengine.cpp",
        "EGLImageBuffer.cpp",
        "EGLImageWrapper.cpp",
        "Tonemapper.cpp",
    ],

}
