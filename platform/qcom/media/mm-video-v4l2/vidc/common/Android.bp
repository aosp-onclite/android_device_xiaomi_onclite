cc_library_static {
    name: "libOmxVidcCommon",
    vendor: true,

    srcs: [
        "src/extra_data_handler.cpp",
        "src/vidc_color_converter.cpp",
        "src/vidc_vendor_extensions.cpp"
    ],

    cflags: [
        "-Werror",
        "-Wno-unused-variable",
        "-Wno-unused-but-set-variable",
        "-Wno-format",
        "-D_ANDROID_",
        "-D_ANDROID_ICS_",
        "-Wno-macro-redefined",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-unused-label",
        "-Wno-gnu-designator",
        "-Wno-typedef-redefinition",
        "-Wno-shorten-64-to-32",
        "-Wno-tautological-compare",
        "-Wno-unused-function",
        "-Wno-unused-local-typedef",
        "-Wno-tautological-pointer-compare",
        "-Wno-missing-field-initializers",
        "-Wno-implicit-float-conversion",
        "-Wno-sign-conversion",
        "-Wno-conversion",
        "-Wno-unused-value",
    ] + select(soong_config_variable("qtidisplay", "target_kernel_version"), {
        "4.9": ["-D_TARGET_KERNEL_VERSION_49_"],
        default: [],
    }),

    header_libs: [
        "display_headers",
        "libc2dcolorconvert_headers",
        "libomxcommon_headers",
        "libomxcore_headers",
        "libutils_headers",
        "qti_kernel_headers",
    ],
}

cc_library_headers {
    name: "libomxcommon_headers",
    export_include_dirs: ["inc"],
    vendor: true,
}
