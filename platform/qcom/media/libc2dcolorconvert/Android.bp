cc_library_shared {
    name: "libc2dcolorconvert",
    vendor: true,
    enabled: false,

    srcs: [
        "C2DColorConverter.cpp",
    ],

    cflags: [
        "-Werror",
        "-Wno-unused-variable",
        "-Wno-unused-but-set-variable",
        "-Wno-format",
        "-Wno-macro-redefined",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-unused-label",
        "-Wno-gnu-designator",
        "-Wno-typedef-redefinition",
        "-Wno-shorten-64-to-32",
        "-Wno-tautological-compare",
        "-Wno-unused-function",
        "-Wno-unused-local-typedef",
        "-Wno-tautological-pointer-compare",
        "-Wno-missing-field-initializers",
        "-Wno-implicit-float-conversion",
        "-Wno-sign-conversion",
        "-Wno-conversion",
        "-Wno-unused-value",
    ],

    header_libs: [
        "display_headers",
        "qti_kernel_headers",
    ],

    shared_libs: [
        "libdl",
        "liblog",
    ],
}

cc_library_headers {
    name: "libc2dcolorconvert_headers",
    export_include_dirs: ["."],
    vendor: true,
}
