cc_library_shared {
    name: "libqcomvoiceprocessing",
    relative_install_path: "soundfx",
    vendor: true,
    owner: "qti",

    srcs: [
        "voice_processing.c",
    ],

    cflags: [
        "-fvisibility=hidden",
        "-Werror",
        "-Wno-unused-variable",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-unused-label",
        "-Wno-gnu-designator",
        "-Wno-typedef-redefinition",
        "-Wno-shorten-64-to-32",
        "-Wno-tautological-compare",
        "-Wno-unused-function",
        "-Wno-unused-local-typedef",
        "-Wno-unused-value",
        "-Wno-macro-redefined",
        "-Wno-unused-but-set-variable",
        "-Wno-format",
        "-Wno-tautological-pointer-compare",
        "-Wno-missing-field-initializers",
        "-Wno-implicit-float-conversion",
        "-Wno-sign-conversion",
        "-Wno-conversion",
    ] + select(soong_config_variable("qtiaudio_onc", "feature_gcov"), {
        true: [
            "--coverage",
            "-fprofile-arcs",
            "-ftest-coverage",
        ],
        default: [],
    }),

    cppflags: select(soong_config_variable("qtiaudio_onc", "feature_gcov"), {
        true: [
            "--coverage",
            "-fprofile-arcs",
            "-ftest-coverage",
        ],
        default: [],
    }),

    include_dirs: [
        "system/media/audio_effects/include",
    ],

    header_libs: [
        "libhardware_headers",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
    ],

    static_libs: select(soong_config_variable("qtiaudio_onc", "feature_gcov"), {
        true: ["libprofile_rt"],
        default: [],
    }),
}
